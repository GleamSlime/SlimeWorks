app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

**/output/*

.env
.env.*

rust/**/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
rust/**/gen/schemas

*.db
*.sqlite
*.crt
*.key
*.p12
*.pem

# 自签代码签名证书产物（含私钥，绝不入库）。重新生成等于换签名身份，
# 用户机器上的 TCC 授权（完全磁盘访问/外置卷）会全部失效，所以必须挡住误提交。
mac_signing_cert/

*.g.dart
*_keyword.json
!rust/novel_reader/tag_keyword.json

# FVM Version Cache
.fvm/
*.exe

extendProject/

# Scripts that may contain sensitive info
scripts/auto.py
scripts/*.py

# 发版产物
dist/
SlimeWorks/**/*.bin
scripts/PWD.md