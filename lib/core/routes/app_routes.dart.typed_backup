// 占位页面路由基类
abstract class PlaceholderRoute extends GoRouteData {
  const PlaceholderRoute();

  String get title;

  @override
  Widget build(BuildContext context, GoRouterState state) {
    return Scaffold(
      body: Center(child: Text('$title 页面开发中...', style: const TextStyle(fontSize: 24))),
    );
  }
}

